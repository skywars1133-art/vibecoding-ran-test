<?xml version="1.0" encoding="utf-8"?>
<!-- Widget card: the same deep board-green gradient as the app icon. RemoteViews needs a plain shape. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="24dp" />
    <gradient
        android:angle="315"
        android:endColor="@color/brand_deep_green_dark"
        android:startColor="#FF15805D" />
    <stroke
        android:width="1dp"
        android:color="#1FFFFFFF" />
</shape>
