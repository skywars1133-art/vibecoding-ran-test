<?xml version="1.0" encoding="utf-8"?>
<!--
    ChessLock keeps every statistic, puzzle history and usage record on the device (SPEC 6).
    Backups are already disabled; these rules also exclude everything from Android 12+ cloud
    backups and device-to-device transfers so private data can never leave the phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
