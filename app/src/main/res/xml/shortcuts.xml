<?xml version="1.0" encoding="utf-8"?>
<!-- Static launcher shortcuts. Keep the actions in sync with ShortcutDestination. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_puzzle"
        android:shortcutId="puzzle"
        android:shortcutLongLabel="@string/shortcut_puzzle_long"
        android:shortcutShortLabel="@string/shortcut_puzzle_short">
        <intent
            android:action="com.chesslock.shortcut.PUZZLE"
            android:targetClass="com.chesslock.MainActivity"
            android:targetPackage="com.chesslock" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_stats"
        android:shortcutId="statistics"
        android:shortcutLongLabel="@string/shortcut_stats_long"
        android:shortcutShortLabel="@string/shortcut_stats_short">
        <intent
            android:action="com.chesslock.shortcut.STATISTICS"
            android:targetClass="com.chesslock.MainActivity"
            android:targetPackage="com.chesslock" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_settings"
        android:shortcutId="settings"
        android:shortcutLongLabel="@string/shortcut_settings_long"
        android:shortcutShortLabel="@string/shortcut_settings_short">
        <intent
            android:action="com.chesslock.shortcut.SETTINGS"
            android:targetClass="com.chesslock.MainActivity"
            android:targetPackage="com.chesslock" />
    </shortcut>
</shortcuts>
