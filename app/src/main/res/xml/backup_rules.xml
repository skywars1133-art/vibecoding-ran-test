<?xml version="1.0" encoding="utf-8"?>
<!--
    Pre-Android 12 backup rules. `android:allowBackup` is already false, so this is a belt-and-braces
    exclusion of the same private data covered by data_extraction_rules.xml (SPEC 6).
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
