<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget metadata. The 30-minute period is the platform minimum: the minute ticker in
     BudgetWidgetProvider drives the normal refresh, and this period is the safety net that restarts
     it after a force-stop or reboot. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/widget_budget"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
