rules_version = '2';

// ChessLock ranking only. A signed-in player may read the board and write exactly their own row.
// No other collection is accessible. Bounds mirror AppConfig (eloFloor, eloCeiling,
// leaderboardNicknameMinLength/MaxLength); update both together if those defaults change.
service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboard/{userId} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['nickname', 'elo', 'ratedPuzzlesPlayed'])
        && request.resource.data.keys().hasOnly(['nickname', 'elo', 'ratedPuzzlesPlayed'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 3
        && request.resource.data.nickname.size() <= 16
        && request.resource.data.elo is int
        && request.resource.data.elo >= 400
        && request.resource.data.elo <= 2800
        && request.resource.data.ratedPuzzlesPlayed is int
        && request.resource.data.ratedPuzzlesPlayed >= 0;

      // Ranking history is never deleted from the client.
      allow delete: if false;
    }
  }
}
